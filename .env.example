# Margines — konfiguracja
#
# Skopiuj plik do `.env.local`. Klucze sekretne (API, bazy danych) trzymaj
# wyłącznie tutaj lub w zmiennych środowiskowych hostingu. Publikowalny klucz
# Supabase jest wyjątkiem — jest przeznaczony dla przeglądarki i chroniony
# przez RLS. Nigdy nie używaj w aplikacji klucza `service_role`.

# ---------------------------------------------------------------------------
# Supabase (wyłączone — aplikacja zapisuje dane lokalnie w przeglądarce)
# ---------------------------------------------------------------------------
# Zmienne pozostają opcjonalne i nie są odczytywane przy starcie. Nazwy bez
# prefiksu NEXT_PUBLIC_ można w przyszłości dodać na Vercel jako Config lub
# Secret. Publikowalny klucz jest przeznaczony dla przeglądarki i chroniony
# przez RLS. Nigdy nie używaj w aplikacji klucza `service_role`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Zgodność ze starszą konfiguracją (opcjonalnie):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Tłumaczenie automatyczne (opcjonalne)
# ---------------------------------------------------------------------------
# Wybór dostawcy:
#   auto (domyślnie) — DeepL, jeśli jest klucz; w przeciwnym razie LibreTranslate
#   deepl | libretranslate | none — wymusza konkretnego dostawcę lub wyłącza go
TRANSLATION_PROVIDER=auto

# DeepL — oficjalny adapter. Klucz darmowy kończy się na ":fx".
DEEPL_AUTH_KEY=
# Opcjonalnie: własny endpoint zgodny z DeepL (np. proxy).
DEEPL_API_URL=

# LibreTranslate — dowolna instancja zgodna z API /translate.
# Przykład publiczny: https://libretranslate.com (często wymaga klucza).
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---------------------------------------------------------------------------
# Generator przykładowych zdań AI (Gemma 4 przez Google Generative Language API)
# ---------------------------------------------------------------------------
# Używany automatycznie, gdy Tatoeba nie zwróci zdania dla dodawanego słowa.
# Klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Podstawowy model i zapasowy (Google zwraca 503 przy dużym obciążeniu).
GEMINI_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Ostatnia deska ratunku, gdy cała pula Gemma jest zajęta.
GEMINI_EMERGENCY_MODEL=gemini-3.1-flash-lite

# Zgodność ze starym dostawcą zgodnym z OpenAI (opcjonalne).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
