# Margines — konfiguracja serwera
#
# Wszystkie zmienne są używane wyłącznie po stronie serwera (Route Handlers).
# Nie używaj prefiksu NEXT_PUBLIC_ — klucze API nie mogą trafić do przeglądarki.
# Skopiuj ten plik jako `.env.local` i uzupełnij tylko potrzebne sekcje.

# ---------------------------------------------------------------------------
# Tłumaczenie automatyczne (opcjonalne)
# ---------------------------------------------------------------------------
# Wybór dostawcy:
#   auto (domyślnie) — DeepL, jeśli jest klucz; w przeciwnym razie LibreTranslate
#   deepl | libretranslate | none — wymusza konkretnego dostawcę lub wyłącza go
TRANSLATION_PROVIDER=auto

# DeepL — oficjalny adapter. Klucz darmowy kończy się na ":fx".
DEEPL_AUTH_KEY=
# Opcjonalnie: własny endpoint zgodny z DeepL (np. proxy).
DEEPL_API_URL=

# LibreTranslate — dowolna instancja zgodna z API /translate.
# Przykład publiczny: https://libretranslate.com (często wymaga klucza).
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---------------------------------------------------------------------------
# Opcjonalny generator przykładów AI (endpoint techniczny)
# ---------------------------------------------------------------------------
# Uwaga: interfejs kreatora słów nie udostępnia generatora AI. Przykłady są
# wybierane wyłącznie spośród pobranych zdań.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
